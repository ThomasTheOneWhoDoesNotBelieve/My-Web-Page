---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getProjects } from '../lib/projects';

const projects = getProjects();

const allPhotos = projects.flatMap((project) => project.photos);

const wallPool = await Promise.all(
  allPhotos.map(async (photo) => {
    const width = Math.min(960, photo.width);

    const optimized = await getImage({
      src: photo,
      width,
      format: 'webp',
      quality: 88,
    });

    return {
      src: optimized.src,
      width,
      height: Math.round(photo.height * (width / photo.width)),
    };
  })
);
---
<BaseLayout>
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="hero-topline">
        <span class="hero-kicker mono">PHOTOGRAPHY</span>
        <span class="cross" aria-hidden="true">+</span>
      </div>

      <div class="hero-title-wrap">
        <h1>
          <span class="hero-line-main">SOMEWHERE</span>
          <span class="hero-line-between">BETWEEN</span>
          <span class="hero-line-main">MEMORY <b class="hero-inline-plus">+</b> GLASS</span>
        </h1>
      </div>
    </section>

    <section class="photo-wall" id="wall" aria-label="Photography wall"></section>
    
 <script define:vars={{ wallPool }}>
  const wall = document.querySelector('#wall');

  if (wall) {
    const shuffled = [...wallPool];

    // Fisher-Yates shuffle
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }

    const selected = shuffled.slice(0, 24);

    selected.forEach((photo, index) => {
      const cell = document.createElement('div');
      cell.className = 'wall-cell';

      const img = document.createElement('img');
      img.src = photo.src;
      img.alt = '';
      img.width = photo.width;
      img.height = photo.height;
      img.decoding = 'async';
      img.loading = index < 2 ? 'eager' : 'lazy';

      cell.appendChild(img);
      wall.appendChild(cell);
    });
  }
  </script>
  </main>

  <SiteFooter />
</BaseLayout>
