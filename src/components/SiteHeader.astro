---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const home = base;
const page = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---
<header class="site-header rule-bottom">
  <a class="brand" href={home} aria-label="Robin Müller — home">
    <span>ROBIN</span><span>MÜLLER</span>
  </a>

  <nav aria-label="Primary navigation">
    <a href={page('projects/')}>PROJECTS</a>
    <a href={page('about/')}>ABOUT</a>
    <a href="#" aria-label="Contacts — coming later">CONTACTS</a>
  </nav>
</header>
